# --- Despliegue (los lee docker compose, no la app) -------------------------
# Imagen a desplegar. En CI apunta al registro; en local, a la build de aquí.
VALERIAPP_IMAGE=valeriapp:local
# Red docker externa, ya existente, donde viven nginx y Postgres.
VALERIAPP_NETWORK=valeriapp

# Postgres inside the shared docker network (container alias "postgres").
DATABASE_URL=postgres://valeriapp:CAMBIA_ESTO@postgres:5432/valeriapp

# El dominio público desde el que se sirve la app.
PUBLIC_URL=https://valeriapp.example.com
COOKIE_SECURE=true

# Web push. Generate a pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Correo de contacto que se envía al servicio de push si una entrega falla.
VAPID_SUBJECT=mailto:tu@example.com

# Weekly backup email (Resend). Leave the key empty to keep local dumps only.
RESEND_API_KEY=
BACKUP_EMAIL_FROM=onboarding@resend.dev
BACKUP_EMAIL_TO=tu@example.com
BACKUP_RETENTION_DAYS=30
BACKUP_ENABLED=true

REMINDERS_ENABLED=true
PUSH_MAX_LATE_MINUTES=120
